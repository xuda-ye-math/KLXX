\@writefile{toc}{\contentsline {section}{\numberline {15}Illustrative figures}{54}{section.15}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Mode collapse under reverse-KL on a 2D bimodal target. Left: target $\mu $ with equal-mass modes at $(\pm 2,0)$. Right: after training, $\nu _\theta $ collapses onto one mode; the other is missed entirely. Reverse-KL gradient gives no signal to recover the dropped mode (\S  5.1).}}{54}{figure.caption.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Geometric annealing schedule $\pi _\beta \propto \mu _0^{1-\beta }\mu ^\beta $ on a unit-Gaussian-to-bimodal-target problem. Modes emerge between $\beta =0.5$ and $\beta =0.75$ with little overlap --- the failure mode CMT calls \emph  {mass teleportation} (\S  5.2).}}{55}{figure.caption.3}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {16}Adaptive tuned priors --- advantage, requirements, and where the routes break}{55}{section.16}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {16.1}The conceptual advantage of an adaptive prior}{55}{subsection.16.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces The fake-ESS pitfall (\S  5.4). Left: flow samples (red) confined to one mode of a bimodal target. Right: importance-weight histogram is uniform on the visited mode --- $\mathrm  {ESS}=1$ exactly --- while half the target mass is missed.}}{56}{figure.caption.4}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces The three philosophical positions. \emph  {Left:} Camp~A --- unimodal Gaussian prior must be transported to a multimodal target. \emph  {Middle:} Camp~B --- tuned mixture prior matches modes but commits the support (mode lock-in). \emph  {Right:} third way --- keep simple prior, add $\mathrm  {X}_{\hat  \mu }$ regulariser with a sloppy $\hat  \mu $.}}{56}{figure.caption.5}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {16.2}Six requirements an adaptive prior must satisfy}{56}{subsection.16.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Log-ratio landscape and the $\mathrm  {X}$ functional (\S  \ref {sec:thirdway}). Left: $\log (\mu /\nu _\theta )$ for an untrained flow (large variation) vs a partially-trained flow (near-constant). Right: corresponding $\mathrm  {X}_\mu $ values. The functional vanishes when the log-ratio is pointwise constant (Proposition~\ref {prop:zero}), giving normalisation invariance suitable for unnormalised Boltzmann targets.}}{57}{figure.caption.6}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {16.3}Route A --- online-learned mixture with external mode finder}{57}{subsection.16.3}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {16.4}Route B --- defensive mixture with Gaussian long tail}{57}{subsection.16.4}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Trinity in action on the Himmelblau potential. Dark blue: initial Gaussian source samples. Dark red: Trinity output after three stages (diffusion $\to $ L-BFGS $\to $ tamed Langevin) recovering all four modes. Deliberate over-coverage is harmless by Proposition~\ref {prop:invariance}.}}{58}{figure.caption.7}\protected@file@percent }
