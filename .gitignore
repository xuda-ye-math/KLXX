# Hidden files (except .gitignore, the project skills, and tracked notes)
.*
!.gitignore
!.claude/
.claude/*
!.claude/skills/
!.claude/notes/

# Data / model checkpoints (any subfolder) -- published as GitHub release
# assets instead (tag data-L8-sweep); restore with:
#   gh release download data-L8-sweep -D Clock_Lattice/
*.pth
*.pt

# Python bytecode caches
__pycache__/
**/__pycache__/

# LaTeX build artifacts
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.log
*.out
*.synctex.gz
*.toc
*.lof
*.lot
*.nav
*.snm
*.vrb
*.bcf
*.run.xml
*.thm
*.xdv

