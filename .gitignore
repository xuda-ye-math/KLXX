# Hidden files (except .gitignore and the project skills)
.*
!.gitignore
!.claude/
.claude/*
!.claude/skills/

# Data / model checkpoints (any subfolder)
*.pth
*.pt
# ... except the Clock_Lattice runs (tracked per user decision 2026-06-04)
!Clock_Lattice/*.pth

# Python bytecode caches
__pycache__/
**/__pycache__/

# LaTeX build artifacts
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.log
*.out
*.synctex.gz
*.toc
*.lof
*.lot
*.nav
*.snm
*.vrb
*.bcf
*.run.xml
*.thm
*.xdv

