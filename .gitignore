# Hidden files (except .gitignore)
.*
!.gitignore

# Data / model checkpoints (any subfolder)
*.pth
*.pt

# Python bytecode caches
__pycache__/
**/__pycache__/

# LaTeX build artifacts
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.log
*.out
*.synctex.gz
*.toc
*.lof
*.lot
*.nav
*.snm
*.vrb
*.bcf
*.run.xml
*.thm
*.xdv

