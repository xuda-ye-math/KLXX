# Hidden files (except .gitignore)
.*
/AGENTS.md
Molecular_BG*/training_diagnostics/candidates/
Molecular_BG*/training_diagnostics/runs/
!.gitignore

# Generated experiment artifacts are local/mirror-only. Keep final,
# publication-ready outputs under results/ eligible for version control.
**/artifacts/

# Data / model checkpoints and large arrays (any subfolder) -- published as
# GitHub release assets instead (tag data-L8-sweep); restore with:
#   gh release download data-L8-sweep -D Clock_Lattice/
*.pth
*.pt
*.npz
*.h5
*.eqx

# Python bytecode caches
__pycache__/
**/__pycache__/

# LaTeX build artifacts
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.log
*.out
*.synctex.gz
*.toc
*.lof
*.lot
*.nav
*.snm
*.vrb
*.bcf
*.run.xml
*.thm
*.xdv

# Local git helper scripts (machine-specific, untracked)
git_init.sh
git_overleaf.sh

# Auto-written per-run driver snapshot (provenance; regenerated each run)
Molecular_BG*/*/run.py

# Local molecular-dynamics run streams and intermediate reports. Immutable
# manifests and final aggregate analysis remain eligible for version control.
Molecular_BG*/data/runs/*/*.stdout
Molecular_BG*/data/runs/*/interim_*/
Molecular_BG*/data/runs/*/final_*/

# Working lit-review notes (not part of the manuscript)
Paper/references.md
arXiv-2602.03729v2.tar.gz
/status.md

# Downloaded reference PDFs (checked against citations, not part of the source)
External/978-1-4684-9393-1.pdf
External/0508594v1.pdf

# The F_star draft and its report: kept locally, not part of the repository
Paper/main_F_star.tex
Paper/report_F_star.tex
Paper/main_F_star.pdf
Paper/report_F_star.pdf

# Collaborator proofreading report on the manuscript: kept locally
/KLXX_proofreading_report.pdf

# Working records of collaborator edits and review replies: kept locally
edit_*.md
edit*.pdf
